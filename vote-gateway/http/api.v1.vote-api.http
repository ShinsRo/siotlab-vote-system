@baseUrl = http://localhost:8080
@authUrl = {{baseUrl}}/auth/token
@campaignId = 1

### 임시 access token 발급
# 응답 형태: { "success": true, "data": { "accessToken": "...", "tokenType": "Bearer", "expiresAt": "..." } }
POST {{authUrl}}
Content-Type: application/json
Accept: application/json

{
  "issuer": "local-dev",
  "principalId": "101",
  "subject": "issuer-user-1",
  "roles": ["user"],
  "scopes": ["vote:read"]
}
> {%
client.global.set("accessToken", response.body.data.accessToken);
 %}

### 게이트웨이 경유 캠페인 목록 조회
# 응답 형태: { "success": true, "data": [...] }
GET {{baseUrl}}/vote-api/api/v1/campaigns
Accept: application/json
Authorization: Bearer {{accessToken}}

### 게이트웨이 경유 캠페인 단건 조회
# 응답 형태: { "success": true, "data": { ... } }
GET {{baseUrl}}/vote-api/api/v1/campaigns/{{campaignId}}
Accept: application/json
Authorization: Bearer {{accessToken}}
