@baseUrl = http://localhost:8089
@policyId = 1

### 투표 정책 생성
# 응답 형태: { "success": true, "data": { ... } }
POST {{baseUrl}}/api/v1/adm/policies
Content-Type: application/json
Accept: application/json

{
  "name": "단일 선택 정책",
  "type": "SingleChoicePolicy",
  "params": "{}"
}

### 투표 정책 수정
# 응답 형태: { "success": true, "data": { ... } }
PATCH {{baseUrl}}/api/v1/adm/policies/{{policyId}}
Content-Type: application/json
Accept: application/json

{
  "name": "복합 투표 정책",
  "type": "CompositePolicy",
  "params": "{\"policies\":[{\"type\":\"SingleChoicePolicy\",\"params\":{}},{\"type\":\"MultipleChoicePolicy\",\"params\":{\"minChoices\":1,\"maxChoices\":2}}]}"
}

### 투표 정책 삭제
# 응답 형태: { "success": true, "data": null } 또는 data 생략
DELETE {{baseUrl}}/api/v1/adm/policies/{{policyId}}
Accept: application/json
